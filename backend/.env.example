ENVIRONMENT=production
DEBUG=False
HOST=0.0.0.0
PORT=8000
FRONTEND_ORIGIN=https://yourdomain.com

JWT_SECRET_KEY=your_secure_random_jwt_secret_here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
# LLM (Groq - OpenAI-compatible)
OPENAI_API_KEY=your_groq_api_key_here
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_FALLBACK_MODEL=openai/gpt-oss-20b
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_RETRY_BASE_DELAY_SECONDS=2.0
LLM_RATE_LIMIT_MAX_DELAY_SECONDS=30.0
LLM_CONCURRENCY_LIMIT=1
LLM_MIN_REQUEST_DELAY_SECONDS=2.0
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=1024
LLM_JSON_MAX_OUTPUT_TOKENS=8192

OTP_EXPIRE_MINUTES=10
OTP_REQUEST_COOLDOWN_SECONDS=60
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=True

# Web Search (Tavily)
TAVILY_API_KEY=your_tavily_api_key_here

# Database
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/agentiq

# Video Search (Pexels)
PEXELS_API_KEY=your_pexels_api_key_here